          "body": "<style>\n* {box-sizing: border-box;margin: 0;padding: 0}\n:root {--bg: #f4f4f6;--fg: #1a1a22;--accent: #7b3ff2;--accent-soft: #efe8ff;--line: #b9b9c6;--muted: #6a6a78;--paper: #ffffff}\nhtml {-webkit-text-size-adjust: 100%}\nbody {font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", sans-serif;background: var(--bg);color: var(--fg);line-height: 1.65;font-size: 16px}\na {color: var(--accent);text-decoration: none;border-bottom: 1px solid currentColor}\na:hover {opacity: 0.75}\n.hero {background: var(--paper);border-bottom: 1px solid var(--line);padding: 4rem 1.25rem 3.5rem;text-align: center;overflow: hidden}\n.hero h1 {font-size: clamp(4rem, 22vw, 17rem);font-weight: 900;letter-spacing: -0.04em;line-height: 0.85;color: var(--fg);margin: 0 auto 1.5rem;max-width: 100%;word-break: break-all}\n.hero .lede {max-width: 40rem;margin: 0 auto 2rem;font-size: 1.05rem;color: var(--muted)}\n.hero .quick-links {display: flex;flex-wrap: wrap;gap: 0.75rem 1.5rem;justify-content: center;font-size: 0.95rem}\n.hero .quick-links a {border: 1px solid var(--line);padding: 0.5rem 1rem;color: var(--fg);border-bottom: 1px solid var(--line)}\n.hero .quick-links a:hover {border-color: var(--accent);color: var(--accent);opacity: 1}\n\n.section {max-width: 880px;margin: 0 auto;padding: 3rem 1.25rem}\n.section h2 {font-size: 1.4rem;margin-bottom: 1.25rem;border-left: 4px solid var(--accent);padding-left: 0.75rem}\n.section p {margin-bottom: 1rem;color: #333}\n.section ul {padding-left: 1.25rem;margin-bottom: 1rem}\n.section li {margin-bottom: 0.35rem}\n\n.intro {background: var(--paper);border-bottom: 1px solid var(--line)}\n\n.plans {background: var(--bg)}\n.plan {background: var(--paper);border: 2px dashed var(--line);border-radius: 10px;padding: 1.5rem 1.5rem 1.75rem;margin-bottom: 1.5rem;position: relative}\n.plan.featured {border-color: var(--accent);background: linear-gradient(180deg, var(--accent-soft